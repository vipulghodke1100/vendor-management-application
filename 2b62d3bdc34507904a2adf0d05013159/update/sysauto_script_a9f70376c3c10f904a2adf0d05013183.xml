        <script><![CDATA[var gr = new GlideRecord(
    'x_1956466_vendor_0_vendor_main'
);

gr.addQuery('active', true);
gr.query();

while(gr.next()) {

    var today = new GlideDate();

    var expiry = new GlideDate();

    expiry.setValue(
        gr.expiry_date
    );

    // If expiry date passed
    if(today.after(expiry)) {

        gr.active = false;

        gr.state = 'expired';

        gr.update();

        gs.info(
            "Vendor Expired: " +
            gr.vendor_name
        );
    }
}]]></script>
